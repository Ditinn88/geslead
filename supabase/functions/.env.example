# Secrets des Edge Functions (à copier dans supabase/functions/.env, jamais dans le code)
# Envoi : npx supabase secrets set --env-file supabase/functions/.env
# Une valeur par ligne, sans guillemets ni commentaire sur la même ligne.

# Adresse publique exacte du site, sans / final (page de retour après paiement)
# Maketou refuse localhost : pour un test local, utiliser un tunnel ou http://localtest.me:3000
APP_URL=https://votre-domaine.com

# =========================================================
# MAKETOU (paiement actif)
# =========================================================

# Maketou → Autres → Clés API → Ajouter une clé API (affichée une seule fois)
MAKETOU_API_KEY=

# Devise des produits Maketou (XOF par défaut, XAF pour l'Afrique centrale)
MAKETOU_CURRENCY=XOF

# Packs de crédits (jusqu'à 5) : un produit Maketou à prix fixe par pack
# PRODUCT_ID : Produit → Partager → Identifiant public du produit
# PRICE : doit être exactement le prix du produit dans Maketou
# Valeurs d'exemple, à remplacer par vos propres tarifs
MAKETOU_PACK_1_PRODUCT_ID=
MAKETOU_PACK_1_CREDITS=15
MAKETOU_PACK_1_PRICE=2000
MAKETOU_PACK_2_PRODUCT_ID=
MAKETOU_PACK_2_CREDITS=45
MAKETOU_PACK_2_PRICE=5000
MAKETOU_PACK_3_PRODUCT_ID=
MAKETOU_PACK_3_CREDITS=150
MAKETOU_PACK_3_PRICE=15000

# =========================================================
# MONEROO (conservé, non branché à l'interface)
# =========================================================

# Moneroo → Developers → API keys (clé de test pour les essais, clé live en production)
MONEROO_SECRET_KEY=

# Moneroo → Developers → Webhooks → secret de signature du webhook
MONEROO_WEBHOOK_SECRET=

MONEROO_CURRENCY=XOF
MONEROO_PACK_1_CREDITS=15
MONEROO_PACK_1_PRICE=2000
